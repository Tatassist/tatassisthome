---
import Layout from '../layouts/LindaCoverupLayout.astro';

const intakeUrl = 'https://www.wixforms.com/f/7421014711090545664';

const heroRail = [
	{
		src: '/lindagcoverups/collarbone-after.jpg',
		alt: 'Finished sunflower collarbone cover-up tattoo by Linda G',
		label: 'Sunflower collarbone',
	},
	{
		src: '/lindagcoverups/elephant-healed.jpg',
		alt: 'Healed sapphire-blue botanical cover-up tattoo by Linda G',
		label: 'Sapphire botanical cover-up',
	},
	{
		src: '/lindagcoverups/story-finished.jpg',
		alt: 'Finished winter snow globe shoulder cover-up tattoo by Linda G',
		label: 'Winter scene',
	},
	{
		src: '/lindagcoverups/flag-finished.jpg',
		alt: 'Finished floral and music cover-up tattoo by Linda G',
		label: 'Color, memory & music',
	},
];

const transformations = [
	{
		featured: true,
		label: 'Collarbone transformation',
		title: 'Small marks. A new focal point.',
		copy: 'A sunflower composition follows the collarbone, redirects the eye, and gives the placement a completely new identity.',
		before: '/lindagcoverups/collarbone-before.jpg',
		beforeAlt: 'Two small hearts on the collarbone before Linda G designed the cover-up',
		after: '/lindagcoverups/collarbone-after.jpg',
		afterAlt: 'Finished sunflower collarbone cover-up tattoo by Linda G',
	},
	{
		label: 'Winter-world transformation',
		title: 'A faded tattoo becomes an entire world.',
		copy: 'The finished winter scene changes the scale, mood, and visual language of the placement.',
		before: '/lindagcoverups/story-before.jpg',
		beforeAlt: 'Original tattoo before Linda G created the winter-world cover-up',
		cropBefore: true,
		after: '/lindagcoverups/story-finished.jpg',
		afterAlt: 'Finished detailed winter snow globe cover-up tattoo',
	},
	{
		label: 'Sapphire botanical transformation',
		title: 'Saturated color. A completely new focal point.',
		copy: 'Layered blue florals and sweeping leaves turn the entire placement into one cohesive, saturated composition.',
		before: '/lindagcoverups/elephant-before.jpg',
		beforeAlt: 'Original faded elephant tattoo before its cover-up',
		after: '/lindagcoverups/elephant-healed.jpg',
		afterAlt: 'Healed sapphire-blue botanical cover-up tattoo',
	},
	{
		label: 'Color, memory & music',
		title: 'Personal meaning without visual compromise.',
		copy: 'A larger composition gives the new artwork enough presence to stand completely on its own.',
		before: '/lindagcoverups/flag-before.jpg',
		beforeAlt: 'Small American flag tattoo before the cover-up',
		after: '/lindagcoverups/flag-finished.jpg',
		afterAlt: 'Finished flower, clover, and musical cover-up tattoo',
	},
];

const fitPoints = [
	{
		number: '01',
		title: 'Strong transformation potential',
		copy: 'Enough freedom in the size, placement, and subject to create a completely new focal point.',
	},
	{
		number: '02',
		title: 'A project worthy of custom design',
		copy: 'Large, detailed work where color and composition can replace the old visual story instead of merely darkening it.',
	},
	{
		number: '03',
		title: 'Commitment to the process',
		copy: 'The right cover-up may require scale, multiple sessions, and trust in Linda’s design direction.',
	},
];
---

<Layout
	title="Linda G | Premium Color Cover-Up Tattoos in Las Vegas"
	description="Get the tattoo you’re actually proud to wear. Premium custom color cover-ups by Linda G in Las Vegas, with projects personally selected for transformation potential."
>
	<header class="lg-header" data-lg-header>
		<a class="lg-brand" href="#top" aria-label="Linda G cover-up tattoos home">
			<strong>LINDA G</strong>
			<span>Custom cover-up tattoos</span>
		</a>

		<nav class="lg-nav" aria-label="Primary navigation">
			<a href="#gallery">Gallery</a>
			<a href="#story">Approach</a>
			<a href="#fit">Project fit</a>
			<a class="lg-nav-cta" href={intakeUrl}>Submit your project</a>
		</nav>

		<button
			class="lg-menu-toggle"
			type="button"
			aria-label="Open navigation"
			aria-expanded="false"
			data-lg-menu-toggle
		>
			<span></span>
			<span></span>
		</button>
	</header>

	<div class="lg-mobile-menu" data-lg-mobile-menu hidden>
		<a href="#gallery">Gallery</a>
		<a href="#story">Approach</a>
		<a href="#fit">Project fit</a>
		<a href={intakeUrl}>Submit your project</a>
	</div>

	<main id="main">
		<section class="lg-hero" id="top">
			<div class="lg-hero-media" aria-hidden="true">
				<img
					src="/lindagcoverups/hero-purple-rose.jpg"
					alt=""
					width="1196"
					height="1678"
					fetchpriority="high"
					decoding="async"
				/>
			</div>

			<div class="lg-hero-copy">
				<div class="lg-hero-eyebrow">
					<span>Custom cover-up tattoos</span>
					<span>Las Vegas</span>
				</div>

				<h1>
					<span>Get the tattoo</span>
					<span>you’re actually</span>
					<em>proud to wear.</em>
				</h1>

				<p class="lg-hero-lead">Replace the old story with custom cover-up artwork designed to be seen.</p>
				<p class="lg-hero-body">Linda creates intentional color cover-ups for clients ready to move from regret to a piece they love wearing.</p>

				<div class="lg-hero-actions">
					<a class="lg-button lg-button-primary" href={intakeUrl}>See if your project qualifies</a>
				</div>

				<p class="lg-hero-note">Submissions are personally reviewed. Consultations are offered by invitation only.</p>
			</div>

			<div class="lg-hero-seal" aria-hidden="true">LG</div>

			<div class="lg-hero-rail" aria-label="Selected tattoos by Linda G">
				{heroRail.map((item) => (
					<figure>
						<img src={item.src} alt={item.alt} loading="eager" decoding="async" />
						<figcaption>{item.label}</figcaption>
					</figure>
				))}
			</div>
		</section>

		<section class="lg-gallery" id="gallery">
			<div class="lg-gallery-header">
				<div>
					<p class="lg-kicker violet">Transformations you’ll be proud to wear</p>
					<h2>The Cover-Up Gallery</h2>
				</div>
				<p>The finished tattoo leads. The old tattoo appears only to show how far the work traveled.</p>
			</div>

			<div class="lg-transform-grid">
				{transformations.map((item) => (
					<article class:list={['lg-transform-card', item.featured && 'is-featured']}>
						<div class="lg-transform-pair">
							<div class="lg-transform-image">
								<img
									class:list={{ 'lg-story-before-crop': item.cropBefore }}
									src={item.before}
									alt={item.beforeAlt}
									loading="lazy"
									decoding="async"
								/>
								<span>Before</span>
							</div>
							<div class="lg-transform-image">
								<img src={item.after} alt={item.afterAlt} loading="lazy" decoding="async" />
								<span>After</span>
							</div>
						</div>
						<div class="lg-transform-copy">
							<small>{item.label}</small>
							<h3>{item.title}</h3>
							<p>{item.copy}</p>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="lg-feature" id="story">
			<div class="lg-feature-media">
				<img
					src="/lindagcoverups/story-finished.jpg"
					alt="Finished winter snow globe shoulder cover-up tattoo by Linda G"
					loading="lazy"
					decoding="async"
				/>
				<div class="lg-feature-detail">
					<img
						src="/lindagcoverups/story-progress.jpg"
						alt="Winter scene cover-up tattoo in progress"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>

			<div class="lg-feature-copy">
				<p class="lg-kicker">Art that replaces the old story</p>
				<h2>The cover-up should read as a complete tattoo—not a solution.</h2>
				<p>The existing ink shapes the technical problem. It does not have to dictate the finished artwork. Linda designs forward, using scale, contrast, color, and body flow until the new piece owns the placement.</p>
				<div class="lg-feature-points">
					<span>Finished artwork first</span>
					<span>Coverage built into the composition</span>
					<span>Designed for the body and the healed result</span>
				</div>
			</div>
		</section>

		<section class="lg-healed">
			<div class="lg-healed-copy">
				<p class="lg-kicker violet">Healed proof</p>
				<h2>Color that still has something to say.</h2>
				<p>Fresh work gets attention. Healed work earns trust. This piece was photographed again more than six years later.</p>
			</div>

			<div class="lg-healed-images">
				<figure>
					<div>
						<img src="/lindagcoverups/cherry-fresh.jpg" alt="Fresh cherry blossom leg tattoo by Linda G" loading="lazy" decoding="async" />
					</div>
					<figcaption><span>Fresh</span><span>Day one</span></figcaption>
				</figure>
				<figure>
					<div>
						<img src="/lindagcoverups/cherry-healed-6-years.jpg" alt="Cherry blossom leg tattoo healed more than six years" loading="lazy" decoding="async" />
					</div>
					<figcaption><span>Healed</span><span>Six years later</span></figcaption>
				</figure>
			</div>
		</section>

		<section class="lg-fit" id="fit">
			<div class="lg-fit-copy">
				<p class="lg-kicker">Selected projects only</p>
				<h2>Linda reviews every submission personally.</h2>
				<p>Cover-up consultations are reserved for projects Linda selects based on artistic fit, transformation potential, scope, and availability.</p>
			</div>

			<div class="lg-fit-list">
				{fitPoints.map((point) => (
					<div class="lg-fit-item">
						<span>{point.number}</span>
						<div>
							<h3>{point.title}</h3>
							<p>{point.copy}</p>
						</div>
					</div>
				))}
			</div>
		</section>

		<section class="lg-apply">
			<div class="lg-apply-inner">
				<p class="lg-kicker">Your next piece can be the one you keep showing people</p>
				<h2>Ready to wear the tattoo you actually wanted?</h2>
				<p>Send clear photos of the existing tattoo, your placement, and the direction you want to explore. Linda will review the project and determine whether it is a fit for her cover-up work.</p>
				<a class="lg-button lg-button-primary" href={intakeUrl}>See if your project qualifies</a>
				<div class="lg-apply-note">If selected, the studio will invite you to the next step.</div>
			</div>
		</section>
	</main>

	<footer class="lg-footer">
		<a href="#top">Linda G</a>
		<span>Premium color cover-ups / Las Vegas</span>
		<a href="#top">Back to top ↑</a>
	</footer>

	<script is:inline>
		const header = document.querySelector('[data-lg-header]');
		const menuButton = document.querySelector('[data-lg-menu-toggle]');
		const mobileMenu = document.querySelector('[data-lg-mobile-menu]');

		const closeMenu = () => {
			if (!menuButton || !mobileMenu) return;
			menuButton.setAttribute('aria-expanded', 'false');
			mobileMenu.hidden = true;
			document.body.classList.remove('menu-open');
		};

		menuButton?.addEventListener('click', () => {
			const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
			menuButton.setAttribute('aria-expanded', String(!isOpen));
			if (mobileMenu) mobileMenu.hidden = isOpen;
			document.body.classList.toggle('menu-open', !isOpen);
		});

		mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

		const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
		updateHeader();
		window.addEventListener('scroll', updateHeader, { passive: true });
	</script>
</Layout>
