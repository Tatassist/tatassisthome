---
import Layout from '../layouts/LindaCoverupLayout.astro';

const intakeUrl = 'https://www.wixforms.com/f/7421014711090545664';

const storyStages = [
	{ label: 'Before', src: '/lindagcoverups/story-before.jpg', alt: 'Faded shoulder tattoo before Linda designed the coverup' },
	{ label: 'In progress', src: '/lindagcoverups/story-progress.jpg', alt: 'Winter scene coverup design in progress' },
];

const elephantStages = [
	{ number: '01', label: 'Before', src: '/lindagcoverups/elephant-before.jpg', alt: 'Original faded elephant tattoo before its coverup' },
	{ number: '02', label: 'Structure', src: '/lindagcoverups/elephant-stencil.jpg', alt: 'Botanical coverup stencil placed over the original tattoo' },
	{ number: '03', label: 'Color', src: '/lindagcoverups/elephant-fresh.jpg', alt: 'Botanical elephant coverup partially completed in color' },
	{ number: '04', label: 'Healed', src: '/lindagcoverups/elephant-healed.jpg', alt: 'Healed blue botanical elephant coverup tattoo' },
];

const flagStages = [
	{ label: 'Before', src: '/lindagcoverups/flag-before.jpg', alt: 'Small American flag tattoo before the coverup' },
	{ label: 'Mapped', src: '/lindagcoverups/flag-progress.jpg', alt: 'Flower and music coverup stencil mapped over the original flag' },
	{ label: 'Finished', src: '/lindagcoverups/flag-finished.jpg', alt: 'Finished flower, clover and musical coverup tattoo' },
];

const principles = [
	{ number: '01', title: 'Scale', copy: 'Enough room for the new composition to control what came before it.' },
	{ number: '02', title: 'Color', copy: 'Contrast and saturation placed with purpose, never simply made darker.' },
	{ number: '03', title: 'Meaning', copy: 'A new piece with its own identity, built around the person wearing it.' },
];

const process = [
	{ number: '01', title: 'Review', copy: 'Linda studies the existing tattoo, skin, placement and realistic possibilities.' },
	{ number: '02', title: 'Reimagine', copy: 'A new concept is built around flow, coverage and the story you want next.' },
	{ number: '03', title: 'Refine', copy: 'Scale, shape and focal points are resolved before tattooing begins.' },
	{ number: '04', title: 'Transform', copy: 'The new artwork becomes the focus—not the tattoo underneath it.' },
];
---

<Layout
	title="Linda G | Custom Tattoo Coverups in Las Vegas"
	description="Custom color tattoo coverups by Linda G in Las Vegas. Original transformations designed to stand on their own."
>
	<header class="site-header" data-header>
		<a class="wordmark" href="#top" aria-label="Linda G coverup tattoos home">
			<span>Linda G</span>
			<small>Coverup artist</small>
		</a>
		<nav class="desktop-nav" aria-label="Primary navigation">
			<a href="#transformations">Transformations</a>
			<a href="#process">Process</a>
			<a class="nav-consult" href={intakeUrl}>Submit your project</a>
		</nav>
		<button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" data-menu-toggle>
			<span></span><span></span>
		</button>
	</header>

	<div class="mobile-menu" data-mobile-menu hidden>
		<a href="#transformations">Transformations</a>
		<a href="#process">Process</a>
		<a href={intakeUrl}>Submit your project</a>
	</div>

	<main id="main">
		<section class="hero" id="top">
			<div class="hero-copy">
				<div class="hero-meta" aria-label="Coverup specialist in Las Vegas">
					<span>Coverup specialist</span>
					<span>Las Vegas</span>
				</div>
				<h1>
					<span>Your old tattoo</span>
					<em>isn’t the final word.</em>
				</h1>
				<p class="hero-intro">Linda personally selects cover-up projects where her color work can create a complete transformation—not simply make the old tattoo darker.</p>
				<div class="hero-actions">
					<a class="button button-primary" href={intakeUrl}>See if your project qualifies</a>
					<a class="text-link" href="#transformations">See the transformations <span aria-hidden="true">↓</span></a>
				</div>
				<p class="hero-qualification">Every submission is reviewed personally. Consultations are offered only to projects Linda selects.</p>
			</div>
			<figure class="hero-art">
				<div class="hero-frame">
					<img src="/lindagcoverups/hero-purple-rose.jpg" alt="Purple rose and blue forget-me-not tattoo by Linda G" width="1196" height="1678" fetchpriority="high" />
				</div>
				<figcaption><span>Original artwork</span><span>Built beyond the old tattoo</span></figcaption>
			</figure>
			<div class="hero-number" aria-hidden="true">LG</div>
		</section>

		<section class="manifesto dark-surface">
			<div class="manifesto-statement" data-reveal>
				<p>A coverup is not the art of hiding.</p>
				<h2>It is the art of <em>rebuilding.</em></h2>
			</div>
			<div class="manifesto-copy" data-reveal>
				<p>The strongest coverups are designed as complete tattoos first. Scale, movement, contrast and color work together until the old piece stops defining what comes next.</p>
				<div class="manifesto-proof">
					<span>Original compositions</span>
					<span>Intentional coverage</span>
					<span>Work made to heal beautifully</span>
				</div>
			</div>
		</section>

		<section class="gallery-intro" id="transformations">
			<p class="section-index" data-reveal>Selected transformations / 01—04</p>
			<div class="gallery-intro-grid" data-reveal>
				<h2>Judge the coverup by the tattoo it <em>becomes.</em></h2>
				<p>Every project begins with a limitation. The finished work should feel like it began with possibility.</p>
			</div>
		</section>

		<section class="case case-collarbone">
			<div class="case-heading" data-reveal>
				<span class="case-number">01</span>
				<div>
					<p>Collarbone transformation</p>
					<h3>Small marks.<br />A new focal point.</h3>
				</div>
			</div>
			<div class="collarbone-layout">
				<figure class="image-block collarbone-before" data-reveal>
					<div class="image-shell"><img src="/lindagcoverups/collarbone-before.jpg" alt="Two small hearts on the collarbone before the coverup" width="960" height="1280" loading="lazy" /></div>
					<figcaption><span>Before</span><span>The starting point</span></figcaption>
				</figure>
				<div class="case-note" data-reveal>
					<p>A sunflower composition redirects the eye, uses the collarbone’s movement and gives the placement a completely new identity.</p>
				</div>
				<figure class="image-block collarbone-after" data-reveal>
					<div class="image-shell"><img src="/lindagcoverups/collarbone-after.jpg" alt="Finished sunflower collarbone coverup tattoo" width="1536" height="2048" loading="lazy" /></div>
					<figcaption><span>Finished</span><span>Artwork first</span></figcaption>
				</figure>
			</div>
		</section>

		<section class="case story-case dark-surface">
			<div class="story-copy" data-reveal>
				<span class="case-number">02</span>
				<p>Shoulder transformation</p>
				<h3>A faded tattoo becomes an entire <em>world.</em></h3>
				<p class="case-description">The new scene does more than cover the original. It changes the scale, mood and visual language of the placement.</p>
			</div>
			<div class="story-layout">
				<figure class="story-finished" data-reveal>
					<div class="image-shell"><img src="/lindagcoverups/story-finished.jpg" alt="Finished detailed winter snow globe shoulder tattoo" width="1536" height="2048" loading="lazy" /></div>
					<figcaption>Finished transformation</figcaption>
				</figure>
				<div class="story-stages">
					{storyStages.map((stage) => (
						<figure data-reveal>
							<div class="image-shell"><img class:list={{ 'story-before-image': stage.label === 'Before' }} src={stage.src} alt={stage.alt} loading="lazy" /></div>
							<figcaption>{stage.label}</figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>

		<section class="case elephant-case violet-surface">
			<div class="sequence-heading" data-reveal>
				<div>
					<span class="case-number">03</span>
					<p>Botanical elephant</p>
				</div>
				<h3>Built in stages.<br />Resolved as one piece.</h3>
				<p>Structure controls coverage. Color creates depth. The healed result is what matters.</p>
			</div>
			<div class="sequence-track" aria-label="Four stages of the botanical elephant coverup">
				{elephantStages.map((stage) => (
					<figure data-reveal>
						<div class="sequence-image"><img src={stage.src} alt={stage.alt} loading="lazy" /></div>
						<figcaption><span>{stage.number}</span><strong>{stage.label}</strong></figcaption>
					</figure>
				))}
			</div>
		</section>

		<section class="case flag-case">
			<div class="flag-heading" data-reveal>
				<span class="case-number">04</span>
				<p>Color, memory &amp; music</p>
				<h3>The goal is never simply darker.<br />The goal is <em>better.</em></h3>
			</div>
			<div class="flag-layout">
				{flagStages.map((stage, index) => (
					<figure class:list={{ 'flag-finished': index === 2 }} data-reveal>
						<div class="image-shell"><img src={stage.src} alt={stage.alt} loading="lazy" /></div>
						<figcaption>{stage.label}</figcaption>
					</figure>
				))}
				<div class="flag-note" data-reveal>
					<p>A personal composition with enough scale and saturation to stand completely on its own.</p>
				</div>
			</div>
		</section>

		<section class="craft dark-surface">
			<div class="craft-copy" data-reveal>
				<p class="section-index">Craft in the details</p>
				<h2>Every stage serves the final tattoo.</h2>
				<p>Coverage is only one requirement. The work still needs dimension, clean structure and a finish that reads clearly from across the room.</p>
			</div>
			<div class="craft-images">
				<figure class="craft-progress" data-reveal>
					<div class="image-shell"><img src="/lindagcoverups/truck-progress.jpg" alt="Black and grey truck tattoo in progress" width="1536" height="2048" loading="lazy" /></div>
					<figcaption>In progress</figcaption>
				</figure>
				<figure class="craft-finished" data-reveal>
					<div class="image-shell"><img src="/lindagcoverups/truck-finished.jpg" alt="Finished blue truck tattoo" width="1536" height="2048" loading="lazy" /></div>
					<figcaption>Finished</figcaption>
				</figure>
			</div>
		</section>

		<section class="healed-proof">
			<div class="healed-heading" data-reveal>
				<p class="section-index">Healed proof</p>
				<h2>Beautiful on day one.<br /><em>Still alive six years later.</em></h2>
			</div>
			<div class="six-years" aria-hidden="true">6 YEARS</div>
			<div class="healed-grid">
				<figure data-reveal>
					<div class="image-shell"><img src="/lindagcoverups/cherry-fresh.jpg" alt="Fresh cherry blossom leg tattoo" width="1536" height="2048" loading="lazy" /></div>
					<figcaption><span>Fresh</span><span>Day one</span></figcaption>
				</figure>
				<figure data-reveal>
					<div class="image-shell"><img src="/lindagcoverups/cherry-healed-6-years.jpg" alt="Same cherry blossom leg tattoo healed six years later" width="2105" height="2807" loading="lazy" /></div>
					<figcaption><span>Healed</span><span>Six years later</span></figcaption>
				</figure>
			</div>
			<p class="healing-note" data-reveal>Photographed more than six years later after substantial sun exposure. Consistent aftercare and UV protection can help tattoos retain color and detail longer.</p>
		</section>

		<section class="principles dark-surface">
			<div class="principles-heading" data-reveal>
				<p class="section-index">Linda’s coverup principles</p>
				<h2>Designed forward.<br />Never trapped by the past.</h2>
			</div>
			<div class="principle-list">
				{principles.map((principle) => (
					<div class="principle" data-reveal>
						<span>{principle.number}</span>
						<h3>{principle.title}</h3>
						<p>{principle.copy}</p>
					</div>
				))}
			</div>
		</section>

		<section class="process" id="process">
			<div class="process-heading" data-reveal>
				<p class="section-index">For selected projects</p>
				<h2>A thoughtful transformation,<br />built around you.</h2>
			</div>
			<ol class="process-list">
				{process.map((step) => (
					<li data-reveal>
						<span>{step.number}</span>
						<h3>{step.title}</h3>
						<p>{step.copy}</p>
					</li>
				))}
			</ol>
		</section>

		<section class="consult dark-surface" id="consult">
			<div class="consult-topline" data-reveal>
				<span>Project review</span>
				<span>Consultations by invitation</span>
			</div>
			<div class="consult-grid">
				<div data-reveal>
					<h2>See if your cover-up is a fit for Linda’s work.</h2>
				</div>
				<div class="consult-action" data-reveal>
					<p>Every submission is reviewed for artistic fit, scope, and availability before a consultation is offered. If Linda selects the project, the studio will contact you with the next step.</p>
					<a class="button button-primary" href={intakeUrl}>Submit your project</a>
				</div>
			</div>
			<p class="consult-signoff" aria-hidden="true">Project received. Next step by invitation.</p>
		</section>
	</main>

	<footer class="site-footer">
		<a class="footer-wordmark" href="#top">Linda G</a>
		<p>Custom color tattoo coverups / Las Vegas</p>
		<a href="#top">Back to top <span aria-hidden="true">↑</span></a>
	</footer>

	<script is:inline>
		const header = document.querySelector('[data-header]');
		const menuButton = document.querySelector('[data-menu-toggle]');
		const mobileMenu = document.querySelector('[data-mobile-menu]');

		const closeMenu = () => {
			if (!menuButton || !mobileMenu) return;
			menuButton.setAttribute('aria-expanded', 'false');
			mobileMenu.hidden = true;
		};

		menuButton?.addEventListener('click', () => {
			const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
			menuButton.setAttribute('aria-expanded', String(!isOpen));
			if (mobileMenu) mobileMenu.hidden = isOpen;
		});

		mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

		const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
		updateHeader();
		window.addEventListener('scroll', updateHeader, { passive: true });

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (!reduceMotion && 'IntersectionObserver' in window) {
			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			}, { threshold: 0.1, rootMargin: '0px 0px -4% 0px' });
			document.querySelectorAll('[data-reveal]').forEach((element) => observer.observe(element));
		} else {
			document.querySelectorAll('[data-reveal]').forEach((element) => element.classList.add('is-visible'));
		}
	</script>
</Layout>
