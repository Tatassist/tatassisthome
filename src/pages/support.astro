---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { bookedArtistSystemConfig } from '../data/booked-artist-system';

const { supportEmail, price, guaranteeDays } = bookedArtistSystemConfig;
const supportHref = `mailto:${supportEmail}`;
---

<BaseLayout title="Support" description="Get help with Tatassist purchases, digital delivery, licensing, and refunds." pageType="support">
  <Nav slot="header" />
  <section class="pt-28 sm:pt-36 pb-12 sm:pb-16 bg-brand-dark border-b border-white/5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <p class="text-brand-gold text-sm font-semibold uppercase tracking-widest mb-4">Product and purchase support</p>
      <h1 class="text-4xl sm:text-5xl font-heading font-bold text-brand-cream leading-tight mb-5">Tatassist Support</h1>
      <p class="text-lg sm:text-xl text-brand-text-muted leading-relaxed max-w-3xl mb-8">Need help with payment, your downloads, or a refund? Email us with the address you used at checkout and the product name.</p>
      <a href={supportHref} class="inline-flex items-center justify-center rounded-lg bg-brand-red px-6 py-3 font-semibold text-white hover:bg-brand-red-dark transition-colors" data-track="true" data-track-event="tatassist_support_email_click" data-track-label="Email Tatassist Support" data-track-location="support_hero" data-track-type="email" data-track-destination={supportHref}>Email {supportEmail}</a>
    </div>
  </section>
  <section class="py-14 sm:py-20 bg-brand-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="prose-tatassist max-w-none">
        <h2>The current launch offer</h2>
        <p>The Booked Artist System is <strong>${price} at launch, paid once</strong>. Checkout is through Stripe. This purchase is not a reservation or a recurring membership.</p>
        <h2>Missing downloads</h2>
        <p>After payment, follow the download instructions on the order-complete page. If a download is missing or unavailable, email <a href={supportHref}>{supportEmail}</a> with your purchase email and receipt or transaction reference. Do not send your card number.</p>
        <h2>Refund requests</h2>
        <p>The current product has a <strong>{guaranteeDays}-day satisfaction guarantee</strong>, starting on your purchase date. Send a request from the email used at checkout within that period. See the <a href="/booked-artist-system-terms#refunds">product refund terms</a> for the applicable conditions.</p>
        <h2>What to include</h2>
        <ul><li>The email address used at checkout.</li><li>The product name and receipt or transaction reference, when available.</li><li>What happened and what you need help with.</li></ul>
        <h2>Earlier purchases or a different product</h2>
        <p>Your original checkout and receipt identify the terms and payment provider for an earlier purchase. Today's one-time offer does not change an existing purchase or subscription. Email support if you need help locating the correct record, cancelling an earlier subscription, or checking its refund terms.</p>
        <h2>Keep sensitive information private</h2>
        <p>Do not send payment-card details, government identification, tattoo-client health information, signatures, or completed consent records. We do not need them to investigate a Tatassist purchase.</p>
      </div>
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>
