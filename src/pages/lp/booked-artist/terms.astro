---
import FunnelLayout from '../../../layouts/FunnelLayout.astro';
import FunnelHeader from '../../../components/FunnelHeader.astro';
import '../../../styles/offer-funnel.css';
---

<FunnelLayout
  title="The Booked Artist System — Product Terms"
  description="Product terms for The Booked Artist System."
  pageType="booked_artist_system_terms"
  robots="noindex,follow"
>
  <FunnelHeader slot="header" />

  <section class="pt-28 sm:pt-36 pb-14 sm:pb-20 bg-brand-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="prose-tatassist max-w-none">
        <h1>The Booked Artist System — Product Terms</h1>

        <p>The Booked Artist System is a one-time digital purchase.</p>

        <h2>Refunds</h2>

        <p>Refund requests may be made within 30 days of purchase by emailing <strong><a href="mailto:syd@tatassist.com">syd@tatassist.com</a></strong> from the email used at checkout.</p>

        <h2>License</h2>

        <p>One purchase is for one working tattoo artist.</p>

        <p>You may use and adapt the materials in your own tattoo business. You may not resell, redistribute, share, or publish the files as your own product.</p>

        <h2>Results</h2>

        <p>As with anything in life, no specific business, booking, or income results are guaranteed.</p>

        <p>Questions: <strong><a href="mailto:syd@tatassist.com">syd@tatassist.com</a></strong></p>
      </div>
    </div>
  </section>
</FunnelLayout>
