---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/booked-artist-system.css';

const supportEmail = import.meta.env.PUBLIC_TATASSIST_SUPPORT_EMAIL || 'syd@tatassist.com';
const supportHref = `mailto:${supportEmail}?subject=${encodeURIComponent('Booked Artist System download help')}`;
---

<BaseLayout
  title="Your Booked Artist System Is Ready"
  description="Your Tatassist purchase is complete. Download your Booked Artist System."
  pageType="booked_artist_system_delivery"
  robots="noindex,nofollow"
>
  <section class="bas-delivery">
    <div class="bas-delivery-grid" aria-hidden="true"></div>
    <div class="bas-delivery-card">
      <a class="bas-brand" href="/lp/booked-artist" aria-label="The Booked Artist System">
        <span class="bas-brand-mark" aria-hidden="true">T/A</span>
        <span><b>TATASSIST</b><small>ARTIST SYSTEMS</small></span>
      </a>

      <p class="bas-kicker">PAYMENT COMPLETE</p>
      <h1>YOUR SYSTEM<br />IS READY.</h1>
      <p class="bas-delivery-lead" id="delivery-lead">
        Your payment went through. Your download is being prepared now.
      </p>

      <a
        id="download-button"
        class="bas-button bas-button-primary bas-button-wide"
        href="#"
        target="_blank"
        rel="noopener noreferrer nofollow"
        data-track="true"
        data-track-event="booked_artist_package_downloaded"
        data-track-label="Download purchased edition"
        data-track-location="booked_artist_order_complete"
        data-track-type="download"
        hidden
      >
        DOWNLOAD YOUR SYSTEM <span aria-hidden="true">↓</span>
      </a>

      <p class="bas-delivery-status" id="delivery-status" role="status">
        Confirming your purchased edition…
      </p>

      <div class="bas-delivery-details">
        <div>
          <span>01</span>
          <p><b>Download your files.</b> Save the package somewhere permanent.</p>
        </div>
        <div>
          <span>02</span>
          <p><b>Start with the setup guide.</b> It walks you through the recommended implementation order.</p>
        </div>
        <div>
          <span>03</span>
          <p><b>Keep your receipt.</b> Your purchase is licensed for one working tattoo artist.</p>
        </div>
      </div>

      <p class="bas-delivery-help">
        Trouble downloading or opening the package? Email <a href={supportHref}>{supportEmail}</a> from the address used at checkout.
      </p>

      <div class="bas-signature">
        <strong>JOKER INK</strong>
        <span>BLACK DIAMOND CUSTOM TATTOOS · NORTH LAS VEGAS</span>
      </div>
    </div>
  </section>

  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      const editions = {
        essentials: {
          name: 'Booked Artist Essentials',
          amount: 2700,
          itemId: 'booked_artist_essentials',
          downloadUrl: 'https://drive.google.com/file/d/1Q0ILKh6KC7YJV2TJJFKT2ldDgbgNFYM9/view'
        },
        working: {
          name: 'Booked Artist Working System',
          amount: 4700,
          itemId: 'booked_artist_working',
          downloadUrl: 'https://drive.google.com/file/d/1zFOS55owbcx56pQB53ACsCX-jLVhOmd-/view'
        },
        complete: {
          name: 'Booked Artist Complete System',
          amount: 7700,
          itemId: 'booked_artist_complete',
          downloadUrl: 'https://drive.google.com/file/d/1wwbWI9sMBQlGJX29K_L62zOnpLqBwewd/view'
        }
      };

      const params = new URLSearchParams(window.location.search);
      const tier = params.get('tier');
      const sessionId = params.get('session_id') || '';
      const edition = tier ? editions[tier] : null;

      const button = document.getElementById('download-button');
      const status = document.getElementById('delivery-status');
      const lead = document.getElementById('delivery-lead');

      if (!edition || !/^cs_(?:live|test)_[A-Za-z0-9]+$/.test(sessionId)) {
        if (status) status.textContent = 'We could not identify this order from the return link. Your payment receipt is still valid—contact support and we will get the correct files to you.';
        return;
      }

      if (button) {
        button.href = edition.downloadUrl;
        button.dataset.trackDestination = edition.downloadUrl;
        button.dataset.trackLabel = `Download ${edition.name}`;
        button.hidden = false;
      }
      if (lead) lead.innerHTML = `Your <strong>${edition.name}</strong> purchase is complete. Your files are ready below.`;
      if (status) status.textContent = 'Purchase confirmed.';

      const eventData = {
        type: 'contents',
        amount: edition.amount,
        currency: 'USD',
        contents: [
          {
            id: edition.itemId,
            name: edition.name,
            content_type: 'product',
            quantity: 1,
            amount: edition.amount,
            currency: 'USD'
          }
        ]
      };

      try {
        window.oaiq?.('measure', 'order_created', eventData, { event_id: sessionId });
      } catch {}

      window.tatassistTrack?.({
        event: 'purchase',
        transaction_id: sessionId,
        value: edition.amount / 100,
        currency: 'USD',
        items: [
          {
            item_id: edition.itemId,
            item_name: edition.name,
            price: edition.amount / 100,
            quantity: 1
          }
        ]
      });

      window.tatassistTrack?.({
        event: 'booked_artist_purchase_completed',
        transaction_id: sessionId,
        edition: tier,
        value: edition.amount / 100,
        currency: 'USD'
      });
    });
  </script>

  <style>
    .bas-delivery {
      position: relative;
      isolation: isolate;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: clamp(2rem, 7vw, 6rem) clamp(1rem, 4vw, 3rem);
      overflow: hidden;
      background:
        radial-gradient(circle at 85% 15%, rgba(112, 70, 163, 0.2), transparent 26rem),
        radial-gradient(circle at 10% 90%, rgba(226, 73, 55, 0.13), transparent 24rem),
        #0a0a0a;
      color: #f2eee5;
    }

    .bas-delivery-grid {
      position: absolute;
      inset: 0;
      z-index: -1;
      opacity: 0.22;
      background-image:
        linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
      background-size: 7rem 7rem;
    }

    .bas-delivery-card {
      width: min(100%, 860px);
      padding: clamp(1.5rem, 5vw, 4.5rem);
      border: 1px solid rgba(242, 238, 229, 0.2);
      background: rgba(15, 15, 15, 0.92);
      box-shadow: 1rem 1rem 0 #7046a3;
    }

    .bas-delivery-card .bas-brand {
      margin-bottom: clamp(3.5rem, 8vw, 6rem);
    }

    .bas-delivery-card h1 {
      margin: 0;
      font-family: "Oswald", "Arial Narrow", sans-serif;
      font-size: clamp(4rem, 13vw, 9rem);
      font-weight: 700;
      letter-spacing: -0.055em;
      line-height: 0.8;
      text-transform: uppercase;
    }

    .bas-delivery-lead {
      max-width: 660px;
      margin: 2rem 0 1rem;
      color: rgba(242, 238, 229, 0.75);
      font-size: clamp(1.05rem, 2vw, 1.3rem);
      line-height: 1.55;
    }

    .bas-delivery-lead strong {
      color: #f2eee5;
    }

    .bas-delivery-status {
      margin: 1rem 0 0;
      color: rgba(242, 238, 229, 0.55);
      font-size: 0.9rem;
    }

    .bas-delivery-details {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1px;
      margin-top: 3rem;
      background: rgba(242, 238, 229, 0.16);
    }

    .bas-delivery-details > div {
      padding: 1.4rem;
      background: #111;
    }

    .bas-delivery-details span {
      color: #e24937;
      font-family: "Oswald", "Arial Narrow", sans-serif;
      font-size: 1.8rem;
      font-weight: 700;
    }

    .bas-delivery-details p {
      margin: 0.8rem 0 0;
      color: rgba(242, 238, 229, 0.68);
      line-height: 1.45;
    }

    .bas-delivery-details b {
      display: block;
      color: #f2eee5;
      margin-bottom: 0.2rem;
    }

    .bas-delivery-help {
      margin: 2rem 0 0;
      color: rgba(242, 238, 229, 0.66);
      font-size: 0.92rem;
      line-height: 1.5;
    }

    .bas-delivery-help a {
      color: #f2eee5;
      text-underline-offset: 0.2em;
    }

    .bas-delivery-card .bas-signature {
      border-top-color: rgba(242, 238, 229, 0.7);
    }

    .bas-delivery-card .bas-signature span {
      color: rgba(242, 238, 229, 0.5);
    }

    @media (max-width: 680px) {
      .bas-delivery-card {
        box-shadow: 0.55rem 0.55rem 0 #7046a3;
      }

      .bas-delivery-details {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
