---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { tenxGuide } from '../../../data/tenx-guide';
import { tatassistOffer } from '../../../data/tatassist-offer';
import '../../../styles/tenx-guide.css';
const { pdfPath, coverPath, productPath, landingPath } = tenxGuide;
const supportEmail = tatassistOffer.supportEmail;
---
<BaseLayout title="Your Free Guide: How I 10x'd My Deposits" description="Download your free guide by Joker Ink, then explore the Tatassist Booked Artist System." robots="noindex,follow" pageType="tenx_guide_delivery">
  <div class="tenx">
    <a class="tenx-skip" href="#delivery-main">Skip to content</a>
    <div class="tenx-wrap"><header class="tenx-nav"><a class="tenx-brand" href={landingPath} data-attribution>JOKER INK <span>/</span> TATASSIST</a><span class="tenx-nav-note">Your free guide</span></header></div>
    <div id="delivery-main">
      <section class="tenx-delivery tenx-wrap" aria-labelledby="ready-title"><div><h1 id="ready-title"><span>YOUR GUIDE</span><span>IS <em>READY.</em></span></h1><p class="tenx-intro">How I 10x'd My Deposits in One Month.<br/>Your copy is below. Read it, then take an honest look at the way you book.</p><div class="tenx-actions"><a class="tenx-button" href={pdfPath} download="Tatassist-How-I-10xd-My-Deposits.pdf" data-track="true" data-track-event="tatassist_guide_download_clicked" data-track-label="Download the free PDF" data-track-location="tenx_delivery" data-track-type="download">Download the free PDF <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5"/></svg></a></div><p class="tenx-small">4 pages. No Google account or payment required.</p><a class="tenx-inline" href={pdfPath} target="_blank" rel="noopener" data-track="true" data-track-event="tatassist_guide_opened" data-track-label="Open PDF in browser" data-track-location="tenx_delivery">Open in your browser instead</a></div><figure class="tenx-cover"><img src={coverPath} alt="Cover of How I 10x'd My Deposits in One Month" width="612" height="792"/><figcaption><span>Your copy</span><span>Free PDF</span></figcaption></figure></section>
      <section class="tenx-light tenx-section" aria-labelledby="next-title"><div class="tenx-wrap tenx-next"><div><p class="tenx-section-index">Your next move</p><h2 id="next-title">NOW YOU KNOW<br/>THE WHY.<br/>HERE'S THE HOW.</h2><p>You can build your own system through trial, error, and the time it takes to work out what fits. Or start from The Booked Artist System.</p><p>The implementation guides and plug-in templates give you a practical starting point, ready to customize to your workflow and your clients.</p></div><div class="tenx-offer"><h3>TATASSIST:<br/>THE BOOKED ARTIST SYSTEM</h3><p class="tenx-price">{tatassistOffer.priceLabel}</p><p class="tenx-small">Launch price. One payment.<br/>No subscription.</p><a class="tenx-button" href={productPath} data-attribution data-track="true" data-track-event="tatassist_product_offer_clicked" data-track-label="See the system and everything included" data-track-location="tenx_delivery_offer" data-track-type="product">See the system <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a><p class="tenx-support">Questions? <a href={`mailto:${supportEmail}`}>{supportEmail}</a></p></div></div></section>
    </div>
    <footer class="tenx-footer tenx-wrap"><div class="tenx-footer-top"><a href={landingPath} data-attribution>Back to the free guide</a><nav class="tenx-footer-links" aria-label="Footer"><a href={`mailto:${supportEmail}`}>{supportEmail}</a><a href="/privacy">Privacy</a><a href="/booked-artist-system-terms">Product terms</a></nav></div><p class="tenx-footer-disclaimer">My 10x result is my real, documented experience, not a forecast of yours. Your work, demand, pricing, and how you implement all matter. What you're buying is a practical starting system, not a guaranteed number of deposits.</p><p class="tenx-footer-copy">© {new Date().getFullYear()} Tatassist. All rights reserved.</p></footer>
  </div>
  <script is:inline src="/lead-magnet/attribution.js"></script>
</BaseLayout>
