---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Terms of Use" description="Tatassist Terms of Use." pageType="terms">
  <Nav slot="header" />
  <section class="pt-28 sm:pt-36 pb-14 sm:pb-20 bg-brand-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="prose-tatassist max-w-none">
        <h1>Terms of Use</h1>

        <p>Tatassist provides educational resources and business tools for tattoo artists. Results are not guaranteed.</p>

        <p>Tatassist content may not be copied, resold, redistributed, or presented as your own product without permission.</p>

        <p>Questions: <strong><a href="mailto:syd@tatassist.com">syd@tatassist.com</a></strong></p>
      </div>
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>
