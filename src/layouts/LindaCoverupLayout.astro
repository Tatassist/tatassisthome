---
import '../styles/lindagcoverups.css';
import '../styles/lindagcoverups-editorial.css';
import '../styles/lindagcoverups-hero-separation.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Linda G | Custom Tattoo Coverups in Las Vegas',
	description = 'Original custom tattoo coverups designed by Linda G in Las Vegas.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#080808" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
	</body>
</html>
